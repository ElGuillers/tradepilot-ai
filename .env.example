# TradePilot AI Configuration

# Environment mode: development / production
ENVIRONMENT=development

# Application
APP_NAME=TradePilot AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (defaults to SQLite local if Postgres is not configured)
DATABASE_URL=sqlite+aiosqlite:///./tradepilot.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://tradepilot:tradepilot123@postgres:5432/tradepilot

# AI Configuration (Optional - TradePilot runs in full technical mode without AI)
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Market Data Providers
BINANCE_API_BASE=https://api.binance.com
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Alerts & Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk Management Defaults
DEFAULT_RISK_PER_TRADE_PERCENT=1.5
DEFAULT_ACCOUNT_BALANCE=10000.0
MIN_RISK_REWARD_RATIO=1.5
